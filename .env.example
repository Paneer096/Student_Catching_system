# Makerove — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Core ──────────────────────────────────────────────────────────────────
DEBUG=true
RANDOM_SEED=42
TIMEZONE=Asia/Kolkata

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./makerove.db

# ── Auth & Security ──────────────────────────────────────────────────────
SECRET_KEY=CHANGE-ME-USE-python -c "import secrets; print(secrets.token_hex(32))"
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

# ── CORS ──────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]

# ── Gemini LLM ────────────────────────────────────────────────────────────
# Get your key from https://ai.google.dev
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash-lite
GEMINI_DAILY_REQUEST_CAP=200
GEMINI_TIMEOUT_SECONDS=20
LLM_ENABLED=true

# ── PII Encryption ────────────────────────────────────────────────────────
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# ── Demo Seed Passwords ───────────────────────────────────────────────────
DEMO_TEACHER_PASSWORD=MakeroveTeacher2026!
DEMO_ADMIN_PASSWORD=MakeroveAdmin2026!
DEMO_STUDENT_PASSWORD=MakeroveStudent2026!
DEMO_HOD_PASSWORD=MakeroveHOD2026!
DEMO_COUNSELOR_PASSWORD=MakeroveCounselor2026!
